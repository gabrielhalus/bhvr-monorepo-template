# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# @currentEnv=$APP_ENV

# Environment
# @type=enum(development, production)
APP_ENV=development

# @type=port
APP_PORT=3000

# Number of reverse proxies in front of this API. Each one appends the address it
# saw to X-Forwarded-For, so the client address is the Nth entry from the right —
# everything further left is client-supplied and must not be trusted.
# 1 matches the bundled compose (one nginx). Use 0 when exposing the API directly.
# @type=number
TRUSTED_PROXY_HOPS=1

# CORS allowlist — leave empty for the default same-origin deployment, where the
# proxy serves the SPA and this API under one origin and no CORS header is needed.
# Only set this to run the frontend on a different origin, as full origins:
# https://app.example.com,https://admin.example.com
# @type=string
ALLOWED_ORIGINS=

# Base URL the OAuth providers redirect back to, without a trailing slash. Derived
# from each request by default, which works on any hostname. Set it when the
# browser-facing origin differs from the one registered with the provider
# (edge rewrite, vanity domain, sub-path): https://example.com/api
# @type=string
OAUTH_REDIRECT_BASE=

# Database
# @required @sensitive @type=url
DATABASE_URL=postgres://postgres:admin@localhost:5432/bunstack

# Redis — enables cross-instance rate limiting (and later BullMQ queues).
# Leave empty to fall back to per-process in-memory stores.
# @sensitive @type=url
REDIS_URL=

# Security
# Force system account password reset on next restart
# @type=boolean
SYSTEM_RESET_PASSWORD=false

# Dev safety — outside production, redirect every outbound email to this single test
# recipient instead of the real recipient. Leave empty to disable sending entirely in dev.
# @type=string
DEV_EMAIL_REDIRECT=
