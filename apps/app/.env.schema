# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# @currentEnv=$APP_ENV

# Environment
# @type=enum(development, production)
APP_ENV=development

# ──────────────────────────────────────────────
# Derived client-side vars (injected by Vite)
# ──────────────────────────────────────────────
# Relative on purpose: the browser resolves it against whatever origin it loaded
# the app from, so the bundle carries no hostname and the same image runs behind
# any domain. The proxy (nginx in prod, Vite in dev) routes /api to the API.
VITE_API_URL=/api
